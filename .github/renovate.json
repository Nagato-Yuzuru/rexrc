{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "mise": {
    "managerFilePatterns": ["/(^|/)mise\\.ci\\.toml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Rex's config runs on Lua 5.1",
      "matchManagers": ["mise"],
      "matchDepNames": ["lua"],
      "allowedVersions": "/^5\\.1\\./"
    },
    {
      "description": "One PR bumps every workflow's mise pin together",
      "matchDepNames": ["jdx/mise"],
      "groupName": "mise"
    }
  ],
  "customManagers": [
    {
      "description": "The mise version CI installs, pinned in mise-action's version input",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "jdx/mise-action@\\S+ # \\S+\\n\\s+with:\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
